// Cloudflare Workers (static assets only — no Worker script).
// Deploy: Cloudflare → Workers & Pages → Create → Import a repository (deploy command: npx wrangler deploy)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emcc-gis",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "none"
  }
}
